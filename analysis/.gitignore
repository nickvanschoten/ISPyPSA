# Local data inputs (re-downloaded by reproducer)
data/

# Solved PyPSA networks + intermediate CSVs (regenerable from configs + data)
runs/
benchmarks/runs/
benchmarks/runs_myopic/

# Auto-generated myopic per-period configs (rebuilt by run_myopic.py)
benchmarks/configs_myopic/

# Python bytecode
__pycache__/
*.py[cod]

# Override parent .gitignore to keep simple-msm deliverables and solver logs.
# These are the artefacts the team needs to inspect without re-running solves.
!outputs/simple_msm/*.csv
!benchmarks/logs/*.log
!benchmarks/logs/*.txt
